// Place your key bindings in this file to override the defaults
[
    {
        // Full line delete in terminals
        "key": "cmd+backspace",
        "command": "workbench.action.terminal.sendSequence",
        "when": "terminalEditorFocus",
        "args": {
            "text": "\u0015"
        }
    },
    {
        // New Terminal: create in the panel (correctly wires keybinding
        // soft-dispatch), then move to the editor area. Works around a Cursor
        // bug where terminals created directly as editors after window load
        // lose terminal keybindings (sendSequence, etc.).
        "key": "cmd+t",
        "command": "runCommands",
        "args": {
            "commands": [
                "workbench.action.terminal.new",
                "workbench.action.terminal.moveToEditor"
            ]
        },
        "when": "terminalProcessSupported",
    },
    {
        // New Window
        "key": "cmd+n",
        "command": "workbench.action.newWindow"
    },
    {
        // Mouse button next tab
        "key": "ctrl+tab",
        "command": "workbench.action.nextEditor"
    },
    {
        // Mouse button previous tab
        "key": "ctrl+shift+tab",
        "command": "workbench.action.previousEditor"
    },
    {
        // Disable Cursor AI chat
        "key": "shift+cmd+l",
        "command": "-aichat.insertselectionintochat"
    },
    {
        // Disable Cursor composer chat
        "key": "shift+cmd+l",
        "command": "-composer.newAgentChat"
    },
    {
        // Navigate Forward
        "key": "ctrl+=",
        "command": "workbench.action.navigateForward",
        "when": "canNavigateForward"
    },
    {
        // Newline for Claude Code
        "key": "shift+enter",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u001b\r"
        },
        "when": "terminalFocus"
    },
    {
        "key": "shift+cmd+n",
        "command": "workbench.action.openRecent"
    },
    {
        "key": "ctrl+r",
        "command": "-workbench.action.openRecent"
    },
    {
        "key": "alt+cmd+s",
        "command": "workbench.action.toggleUnifiedSidebarFromKeyboard",
        "when": "cursor.agentIdeUnification.enabled == true && !isAuxiliaryWindowFocusedContext"
    },
    {
        "key": "ctrl+s",
        "command": "workbench.action.files.saveWithoutFormatting"
    },
    {
        "key": "cmd+r s",
        "command": "-workbench.action.files.saveWithoutFormatting"
    },
    {
        // Delete to start of line in the editor (matches the terminal Ctrl+U behavior)
        "key": "cmd+backspace",
        "command": "deleteAllLeft",
        "when": "textInputFocus && !editorReadonly"
    },
]
